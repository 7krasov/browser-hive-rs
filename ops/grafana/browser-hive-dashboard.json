{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "",
  "title": "Browser Hive - Load & Capacity per Scope",
  "uid": "browser-hive-load",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "scope",
        "label": "Scope",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(browser_hive_worker_total_slots, scope)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "max_contexts",
        "label": "WORKER_MAX_CONTEXTS",
        "description": "Per-worker capacity (contexts = concurrent requests per pod) of the selected scope. Only meaningful with a SINGLE scope selected \u2014 it feeds the 'Recommended maxReplicas' panel (peak load / this value). Set it to the scope's WORKER_MAX_CONTEXTS config value.",
        "type": "textbox",
        "query": "3",
        "current": {
          "text": "3",
          "value": "3"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Concurrent busy contexts (load) per scope",
      "description": "Requests in flight right now = active browser contexts. This is the load curve; its daily peak sizes maxReplicas. Instantaneous gauge, sampled at scrape interval.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (scope) (browser_hive_worker_active_contexts{scope=~\"$scope\"})",
          "legendFormat": "{{scope}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Peak busy contexts (selected range)",
      "description": "Max concurrent busy contexts over the dashboard time range, per scope.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "max_over_time( sum by (scope) (browser_hive_worker_active_contexts{scope=~\"$scope\"})[$__range:] )",
          "legendFormat": "{{scope}}",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Recommended maxReplicas (+25% headroom)",
      "description": "ceil( peak_busy_contexts / WORKER_MAX_CONTEXTS * 1.25 ). Set the WORKER_MAX_CONTEXTS variable to this scope's value.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "ceil( max_over_time( sum by (scope) (browser_hive_worker_active_contexts{scope=~\"$scope\"})[$__range:] ) / $max_contexts * 1.25 )",
          "legendFormat": "{{scope}}",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Running workers per scope",
      "description": "One series per scraped worker instance (in K8s: pod), so the count = current replicas.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "count by (scope) (browser_hive_worker_total_slots{scope=~\"$scope\"})",
          "legendFormat": "{{scope}}",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Utilization now",
      "description": "sum(active_contexts) / sum(total_slots). >90% = near capacity.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (scope) (browser_hive_worker_active_contexts{scope=~\"$scope\"}) / sum by (scope) (browser_hive_worker_total_slots{scope=~\"$scope\"})",
          "legendFormat": "{{scope}}",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Utilization % per scope",
      "description": "Busy / capacity. Sustained ~100% means you are capped - the busy-contexts curve above is clipped, so true demand is higher than shown.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (scope) (browser_hive_worker_active_contexts{scope=~\"$scope\"}) / sum by (scope) (browser_hive_worker_total_slots{scope=~\"$scope\"})",
          "legendFormat": "{{scope}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Throughput (requests/sec) per scope",
      "description": "rate(requests_total). Shows the daily traffic profile.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (scope) (rate(browser_hive_worker_requests_total{scope=~\"$scope\"}[5m]))",
          "legendFormat": "{{scope}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failure rate % per scope",
      "description": "5xxx + gRPC failures / total requests. 4xxx client-side codes are not counted.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 49
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (scope) (rate(browser_hive_worker_requests_failed{scope=~\"$scope\"}[5m])) / clamp_min(sum by (scope) (rate(browser_hive_worker_requests_total{scope=~\"$scope\"}[5m])), 0.0001)",
          "legendFormat": "{{scope}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request latency p50 / p95 / p99 per scope",
      "description": "From browser_hive_worker_request_duration_seconds histogram.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 49
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "histogram_quantile(0.50, sum by (scope, le) (rate(browser_hive_worker_request_duration_seconds_bucket{scope=~\"$scope\"}[5m])))",
          "legendFormat": "p50 {{scope}}"
        },
        {
          "refId": "B",
          "datasource": "${datasource}",
          "expr": "histogram_quantile(0.95, sum by (scope, le) (rate(browser_hive_worker_request_duration_seconds_bucket{scope=~\"$scope\"}[5m])))",
          "legendFormat": "p95 {{scope}}"
        },
        {
          "refId": "C",
          "datasource": "${datasource}",
          "expr": "histogram_quantile(0.99, sum by (scope, le) (rate(browser_hive_worker_request_duration_seconds_bucket{scope=~\"$scope\"}[5m])))",
          "legendFormat": "p99 {{scope}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Avg in-flight requests (Little's Law) per scope",
      "description": "rate(request_duration_seconds_sum) = average concurrent requests, immune to scrape sampling. Should track the busy-contexts curve; if it is consistently higher, your scrape interval is too coarse to catch the true peak.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 57
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (scope) (rate(browser_hive_worker_request_duration_seconds_sum{scope=~\"$scope\"}[5m]))",
          "legendFormat": "{{scope}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Refused demand (coordinator)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 65
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Rejected requests/sec by reason",
      "description": "Requests the coordinator refused without reaching a worker. There is no queue: a refused request is gone. no_slots/no_workers = capacity (add replicas). scope_not_found/session_not_found = client or config. Worker metrics cannot show any of this - a rejected request never reaches a worker.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 66
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (reason) (rate(browser_hive_coordinator_requests_rejected_total{scope=~\"$scope\"}[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Capacity rejection rate % per scope",
      "description": "Share of requests refused for lack of capacity (no_slots + no_workers). Anything sustained above zero means the scope is under-provisioned: raise minReplicaCount/maxReplicaCount rather than lowering the KEDA threshold (threshold only controls steady-state utilization, it cannot absorb a burst while a pod starts).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 66
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.001
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (scope) (rate(browser_hive_coordinator_requests_rejected_total{scope=~\"$scope\", reason=~\"no_slots|no_workers\"}[5m])) / clamp_min(sum by (scope) (rate(browser_hive_coordinator_requests_total{scope=~\"$scope\"}[5m])), 0.0001)",
          "legendFormat": "{{scope}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Requests lost to capacity (selected range)",
      "description": "Absolute number of requests refused for lack of capacity over the dashboard time range. This is the cost of the current replica settings, in requests.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 74
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "instant": true,
          "expr": "sum by (scope) (increase(browser_hive_coordinator_requests_rejected_total{scope=~\"$scope\", reason=~\"no_slots|no_workers\"}[$__range]))",
          "legendFormat": "{{scope}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Coordinator view: free slots and healthy workers per scope",
      "description": "What routing actually decides on: the coordinator's discovery cache (refreshed every 10s in K8s mode), not the workers' own gauges. Free slots at zero while rejections rise = genuine saturation. Healthy workers dropping to zero while pods are running = discovery or health-check problem, and the rejections are not a capacity issue.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 80
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (scope) (browser_hive_coordinator_scope_available_slots{scope=~\"$scope\"})",
          "legendFormat": "{{scope}} - free slots"
        },
        {
          "refId": "B",
          "datasource": "${datasource}",
          "expr": "sum by (scope) (browser_hive_coordinator_scope_workers_healthy{scope=~\"$scope\"})",
          "legendFormat": "{{scope}} - healthy workers"
        },
        {
          "refId": "C",
          "datasource": "${datasource}",
          "expr": "sum by (scope) (browser_hive_coordinator_scope_workers_total{scope=~\"$scope\"})",
          "legendFormat": "{{scope}} - discovered workers"
        }
      ]
    }
  ]
}
