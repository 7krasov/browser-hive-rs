{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "",
  "title": "Browser Hive - Load & Capacity per Scope",
  "uid": "browser-hive-load",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "scope",
        "label": "Scope",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(browser_hive_worker_total_slots, scope)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "max_contexts",
        "label": "WORKER_MAX_CONTEXTS",
        "description": "Per-worker capacity (contexts = concurrent requests per pod). Feeds the 'Pods at peak' and 'Recommended maxReplicas' columns of 'Capacity per scope' (peak load / this value). One value for all scopes: set it to WORKER_MAX_CONTEXTS, and filter to one scope at a time if scopes differ.",
        "type": "textbox",
        "query": "2",
        "current": {
          "text": "2",
          "value": "2"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Concurrent busy contexts (load) per scope",
      "description": "Requests in flight right now = active browser contexts. This is the load curve; its daily peak sizes maxReplicas. Instantaneous gauge, sampled at scrape interval.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (scope) (browser_hive_worker_active_contexts{scope=~\"$scope\"})",
          "legendFormat": "{{scope}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "Capacity per scope",
      "description": "One row per scope, sorted by name. Workers now = scraped worker instances (in K8s: pods). Utilization now = busy / total slots (>80% yellow, >95% red). Peak busy contexts = max concurrent busy contexts over the selected range; Pods at peak = that peak / WORKER_MAX_CONTEXTS (the dashboard variable - one value for all scopes); Recommended maxReplicas = ceil(pods at peak * 1.25). The peak is clipped by the capacity that existed: a scope with requests lost to capacity (coordinator no_slots|no_workers rejections over the range) needed more than its peak shows, so its recommendation is a lower bound.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "datasource": "${datasource}",
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "count by (scope) (browser_hive_worker_total_slots{scope=~\"$scope\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": "${datasource}",
          "expr": "sum by (scope) (browser_hive_worker_active_contexts{scope=~\"$scope\"}) / sum by (scope) (browser_hive_worker_total_slots{scope=~\"$scope\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": "${datasource}",
          "expr": "max_over_time( sum by (scope) (browser_hive_worker_active_contexts{scope=~\"$scope\"})[$__range:] )",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "datasource": "${datasource}",
          "expr": "max_over_time( sum by (scope) (browser_hive_worker_active_contexts{scope=~\"$scope\"})[$__range:] ) / $max_contexts",
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "datasource": "${datasource}",
          "expr": "ceil( max_over_time( sum by (scope) (browser_hive_worker_active_contexts{scope=~\"$scope\"})[$__range:] ) / $max_contexts * 1.25 )",
          "format": "table",
          "instant": true
        },
        {
          "refId": "F",
          "datasource": "${datasource}",
          "expr": "round( sum by (scope) (increase(browser_hive_coordinator_requests_rejected_total{scope=~\"$scope\", reason=~\"no_slots|no_workers\"}[$__range])) ) or on (scope) (0 * group by (scope) (browser_hive_worker_total_slots{scope=~\"$scope\"}))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "scope": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6
            },
            "renameByName": {
              "scope": "Scope",
              "Value #A": "Workers now",
              "Value #B": "Utilization now",
              "Value #C": "Peak busy contexts",
              "Value #D": "Pods at peak",
              "Value #E": "Recommended maxReplicas",
              "Value #F": "Lost to capacity (range)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Scope"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 380
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Utilization now"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.8
                    },
                    {
                      "color": "red",
                      "value": 0.95
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pods at peak"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Recommended maxReplicas"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Lost to capacity (range)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 100
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Scope",
            "desc": false
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Utilization % per scope",
      "description": "Busy / capacity. Sustained ~100% means you are capped - the busy-contexts curve above is clipped, so true demand is higher than shown.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (scope) (browser_hive_worker_active_contexts{scope=~\"$scope\"}) / sum by (scope) (browser_hive_worker_total_slots{scope=~\"$scope\"})",
          "legendFormat": "{{scope}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Throughput (requests/sec) per scope",
      "description": "rate(requests_total). Shows the daily traffic profile.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (scope) (rate(browser_hive_worker_requests_total{scope=~\"$scope\"}[5m]))",
          "legendFormat": "{{scope}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failure rate % per scope",
      "description": "5xxx + gRPC failures / total requests. 4xxx client-side codes are not counted.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (scope) (rate(browser_hive_worker_requests_failed{scope=~\"$scope\"}[5m])) / clamp_min(sum by (scope) (rate(browser_hive_worker_requests_total{scope=~\"$scope\"}[5m])), 0.0001)",
          "legendFormat": "{{scope}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request latency p50 / p95 / p99 per scope",
      "description": "From browser_hive_worker_request_duration_seconds histogram.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "histogram_quantile(0.50, sum by (scope, le) (rate(browser_hive_worker_request_duration_seconds_bucket{scope=~\"$scope\"}[5m])))",
          "legendFormat": "p50 {{scope}}"
        },
        {
          "refId": "B",
          "datasource": "${datasource}",
          "expr": "histogram_quantile(0.95, sum by (scope, le) (rate(browser_hive_worker_request_duration_seconds_bucket{scope=~\"$scope\"}[5m])))",
          "legendFormat": "p95 {{scope}}"
        },
        {
          "refId": "C",
          "datasource": "${datasource}",
          "expr": "histogram_quantile(0.99, sum by (scope, le) (rate(browser_hive_worker_request_duration_seconds_bucket{scope=~\"$scope\"}[5m])))",
          "legendFormat": "p99 {{scope}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Avg in-flight requests (Little's Law) per scope",
      "description": "rate(request_duration_seconds_sum) = average concurrent requests, immune to scrape sampling. Should track the busy-contexts curve; if it is consistently higher, your scrape interval is too coarse to catch the true peak.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (scope) (rate(browser_hive_worker_request_duration_seconds_sum{scope=~\"$scope\"}[5m]))",
          "legendFormat": "{{scope}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Refused demand (coordinator)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 45
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Rejected requests/sec by reason",
      "description": "Requests the coordinator refused without reaching a worker. There is no queue: a refused request is gone. no_slots/no_workers = capacity (add replicas). scope_not_found/session_not_found = client or config. Worker metrics cannot show any of this - a rejected request never reaches a worker.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 46
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (reason) (rate(browser_hive_coordinator_requests_rejected_total{scope=~\"$scope\"}[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Capacity rejection rate % per scope",
      "description": "Share of requests refused for lack of capacity (no_slots + no_workers). Anything sustained above zero means the scope is under-provisioned: raise minReplicaCount/maxReplicaCount rather than lowering the KEDA threshold (threshold only controls steady-state utilization, it cannot absorb a burst while a pod starts).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 46
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.001
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (scope) (rate(browser_hive_coordinator_requests_rejected_total{scope=~\"$scope\", reason=~\"no_slots|no_workers\"}[5m])) / clamp_min(sum by (scope) (rate(browser_hive_coordinator_requests_total{scope=~\"$scope\"}[5m])), 0.0001)",
          "legendFormat": "{{scope}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Coordinator view: free slots and healthy workers per scope",
      "description": "What routing actually decides on: the coordinator's discovery cache (refreshed every 10s in K8s mode), not the workers' own gauges. Free slots at zero while rejections rise = genuine saturation. Healthy workers dropping to zero while pods are running = discovery or health-check problem, and the rejections are not a capacity issue.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 54
      },
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (scope) (browser_hive_coordinator_scope_available_slots{scope=~\"$scope\"})",
          "legendFormat": "{{scope}} - free slots"
        },
        {
          "refId": "B",
          "datasource": "${datasource}",
          "expr": "sum by (scope) (browser_hive_coordinator_scope_workers_healthy{scope=~\"$scope\"})",
          "legendFormat": "{{scope}} - healthy workers"
        },
        {
          "refId": "C",
          "datasource": "${datasource}",
          "expr": "sum by (scope) (browser_hive_coordinator_scope_workers_total{scope=~\"$scope\"})",
          "legendFormat": "{{scope}} - discovered workers"
        }
      ]
    }
  ]
}
